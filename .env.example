EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Voice-to-text on iOS/Android is transcribed by the `transcribe` Edge Function,
# which uses the OPENAI_API_KEY Edge Function secret. No OpenAI key belongs here
# with an EXPO_PUBLIC_ prefix: those values are bundled into the client.

# Dev bypass: set this to skip rate limiting during testing
# REMOVE THIS or leave empty for production/App Store builds
EXPO_PUBLIC_DEV_BYPASS=

# Research harness only (never bundled: no EXPO_PUBLIC_ prefix)
# Phase 3 citation-faithfulness judge (npm run research:judge)
GEMINI_API_KEY=your-gemini-api-key
# Phase 4 cross-family judge (research/harness/judge-citation-gpt.ts)
OPENAI_API_KEY=your-openai-key
